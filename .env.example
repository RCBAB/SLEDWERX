# Copy this file to .env.local and fill in real values locally.
# Never commit .env.local or any file containing real credentials.

# Supabase — Project Settings > API (Data API URL and publishable key).
# The publishable key (sb_publishable_...) is safe for the browser; never put
# a secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Scheduled cleanup (Migration 8, /api/cron/cleanup). Server-only: never use a
# NEXT_PUBLIC_ name for these. In Vercel, set them for Production only.
# CRON_SECRET: a random string of 16+ characters (Vercel Cron sends it).
# SUPABASE_SECRET_KEY: Project Settings > API Keys > secret key (sb_secret_...).
# CLEANUP_MODE: leave unset (report-only). "delete" also needs the database
# switch (see docs/cleanup.md) and separate approval.
CRON_SECRET=
SUPABASE_SECRET_KEY=
CLEANUP_MODE=
