# Copy this file to .env.local and fill in real values locally.
# Never commit .env.local or any file containing real credentials.

# Supabase — Project Settings > API (Data API URL and publishable key).
# The publishable key (sb_publishable_...) is safe for the browser; never put
# a secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
